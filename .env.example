# Copy to .env and edit. NOTHING here is required to run the read-only examples or the tests.

# Which deployment to talk to. REQUIRED, no default. Must match a file in config/ (5042002 Arc
# testnet, 143 Monad); generate others with `bun scripts/gen-config.ts`.
BTR_CHAIN_ID=5042002

# Override the endpoint. Use a private RPC if the public one rate limits you, or point at a
# local anvil fork (http://127.0.0.1:8545) while you are learning.
# BTR_RPC_URL=https://rpc.testnet.arc.io

# Set ONLY to actually send transactions. Without it the write examples print calldata and stop.
# NEVER put a key here that holds anything you would miss. The test suite does not need this: it
# supplies anvil's public development key to a local fork.
# BTR_PRIVATE_KEY=0x...

# Foundry only: pin the fork block for reproducible numbers. 0 or unset means latest.
# BTR_FORK_BLOCK=0
