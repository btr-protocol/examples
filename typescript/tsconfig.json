{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "src",
    "sdk",
    "rpc",
    "test",
    "scripts"
  ]
}
